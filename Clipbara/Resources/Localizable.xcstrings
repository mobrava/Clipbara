    "Clipbara is unlocked" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clipbara está desbloqueado"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clipbara가 잠금 해제되었습니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
