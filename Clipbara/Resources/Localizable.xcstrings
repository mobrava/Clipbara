    "Click, then press a key to use for Quick Look preview" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클릭한 다음 Quick Look 미리보기에 사용할 키를 누르십시오"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按后按下用于快速查看预览的按键"
          }
        }
      }
    },
    "Clicking a clip or pressing Return pastes it where you were typing. When off, the clip is only copied." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클립을 클릭하거나 Return을 누르면 입력하던 곳에 바로 붙여넣습니다. 끄면 복사만 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按剪贴内容或按下 Return 键，即可粘贴到正在输入的位置。关闭时仅复制。"
          }
        }
      }
    },
    "Clip Queue" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클립 대기열"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剪贴队列"
          }
        }
      }
    },
    "Clipbara" : {
      "shouldTranslate" : false
    },
    "Clipbara is unlocked" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clipbara가 잠금 해제되었습니다"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clipbara 已解锁"
          }
        }
      }
    },
    "Clipbara keeps running. To open Settings again, open Clipbara from Applications or Spotlight, or press ⌘, in the panel." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clipbara는 계속 실행됩니다. 설정을 다시 열려면 응용 프로그램 폴더나 Spotlight에서 Clipbara를 실행하거나, 패널에서 ⌘,를 누르세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clipbara 会继续运行。要再次打开设置，请从“应用程序”或聚焦搜索打开 Clipbara，或在面板中按 ⌘,。"
          }
        }
      }
    },
    "Clipbara kept recording what you copy. Settings, including backup export, stay available." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clipbara는 복사한 내용을 계속 기록해 두었습니다. 백업 내보내기를 포함한 설정은 계속 사용할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clipbara 一直在记录你复制的内容。设置（包括备份导出）仍可使用。"
          }
        }
      }
    },
    "Clipbara's data in iCloud is deleted and sync turns off on every device. Clips already on each device stay there." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud에 있는 Clipbara 데이터가 삭제되고 모든 기기에서 동기화가 꺼집니다. 각 기기에 있던 클립은 그대로 남습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 中的 Clipbara 数据将被删除，所有设备上的同步都会关闭。各设备上已有的剪贴内容会保留。"
          }
        }
      }
    },
    "Clipboard Monitoring" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클립보드 모니터링"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "剪贴板监听"
          }
        }
      }
    },
    "Clipboard history as cards" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카드로 보는 클립보드 기록"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以卡片呈现的剪贴板历史"
          }
        }
      }
    },
    "Close" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "닫기"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭"
          }
