        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld clipes, %2$lld imagens (cerca de %3$@) e %4$lld quadros deste dispositivo serão enviados para sua conta do iCloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клипы (%1$lld), изображения (%2$lld, около %3$@) и доски (%4$lld) с этого устройства будут загружены в Вашу учетную запись iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
