    "A single key with no modifiers. It only works while the Clipbara panel is open, so it won't clash with other apps." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine einzelne Taste ohne Sondertasten. Sie funktioniert nur, solange das Clipbara-Fenster geöffnet ist, und kommt anderen Apps daher nicht in die Quere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sola tecla sin modificadores. Solo funciona mientras el panel de Clipbara está abierto, así que no interfiere con otras apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une seule touche, sans modificateur. Elle ne fonctionne que lorsque le panneau Clipbara est ouvert, elle n’entre donc pas en conflit avec les autres apps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un solo tasto senza modificatori. Funziona solo quando il pannello di Clipbara è aperto, quindi non entra in conflitto con altre app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修飾キーなしの単一キーです。Clipbara パネルが開いているときだけ動作するので、ほかのアプリと競合しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보조 키 없이 키 하나만 지정합니다. Clipbara 패널이 열려 있을 때만 동작하므로 다른 앱과 충돌하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma única tecla, sem modificadores. Ela só funciona enquanto o painel do Clipbara está aberto, então não entra em conflito com outros apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одна клавиша без модификаторов. Она работает, только когда открыта панель Clipbara, поэтому не конфликтует с другими приложениями."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只需一个不带修饰键的按键。仅在 Clipbara 面板打开时生效，因此不会与其他应用冲突。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只需一個不帶修飾鍵的按鍵。僅在 Clipbara 面板打開時生效，因此不會與其他 App 衝突。"
          }
        }
      }
    },
