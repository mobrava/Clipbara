    "Width, card size and transparency update an open panel right away. The screen applies the next time the panel opens." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Breite, Kartengröße und Transparenz wirken sich sofort auf ein geöffnetes Fenster aus. Der Bildschirm gilt beim nächsten Öffnen des Fensters."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ancho, el tamaño de las tarjetas y la transparencia se aplican al instante a un panel abierto. La pantalla se aplica la próxima vez que se abra el panel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La largeur, la taille des cartes et la transparence s’appliquent immédiatement à un panneau ouvert. L’écran s’applique à la prochaine ouverture du panneau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Larghezza, dimensioni delle schede e trasparenza si applicano subito a un pannello aperto. Lo schermo si applica alla prossima apertura del pannello."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "幅、カードのサイズ、透明度は開いているパネルにすぐ反映されます。画面の設定は次にパネルを開いたときに反映されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "너비, 카드 크기, 투명도는 열려 있는 패널에 바로 적용됩니다. 화면은 다음에 패널을 열 때 적용됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Largura, tamanho dos cartões e transparência são aplicados na hora a um painel aberto. A tela é aplicada na próxima vez que o painel abrir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ширина, размер карточек и прозрачность сразу применяются к открытой панели. Экран применяется при следующем открытии панели."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宽度、卡片尺寸和透明度会立即应用到已打开的面板，显示屏幕在下次打开面板时生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "寬度、卡片大小和透明度會立即套用到已打開的面板，顯示螢幕在下次打開面板時生效。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}