        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以卡片瀏覽剪貼簿紀錄"
          }
        }
      }
    },
    "Clips older than this are deleted. Clips on pinboards are kept." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los clips más antiguos se eliminan. Los clips de los tableros se conservan."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기간이 지난 항목은 지워집니다. 핀보드에 있는 항목은 지우지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超过此期限的项目会被删除，钉板中的项目会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超過此期限的項目會被刪除，釘選板中的項目會保留。"
          }
        }
      }
    },
