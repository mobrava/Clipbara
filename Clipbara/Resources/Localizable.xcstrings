    "History, pinboards, search and paste all work. The trial is free and never charges or renews on its own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlauf, Pinboards, Suche und Einsetzen funktionieren vollständig. Der Test ist kostenlos und wird nie von selbst berechnet oder verlängert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial, los tableros, la búsqueda y el pegado funcionan. La prueba es gratis y nunca cobra ni se renueva sola."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’historique, les tableaux, la recherche et le collage fonctionnent tous. L’essai est gratuit et n’est jamais facturé ni renouvelé automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cronologia, bacheche, ricerca e incolla funzionano tutti. La prova è gratuita e non viene mai addebitata o rinnovata automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴、ピンボード、検索、ペーストのすべてが使えます。試用は無料で、勝手に課金や更新が行われることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록, 핀보드, 검색, 붙여넣기를 모두 사용할 수 있습니다. 체험은 무료이며 자동으로 결제되거나 갱신되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Histórico, quadros, busca e colar funcionam. O teste é gratuito e nunca cobra nem é renovado sozinho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История, доски, поиск и вставка работают полностью. Пробный период бесплатный и никогда не продлевается и не оплачивается сам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "历史记录、钉板、搜索和粘贴均可使用。试用免费，不会自动扣费或续订。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記錄、釘板、搜尋和貼上均可使用。試用免費，不會自動扣款或續訂。"
          }
        }
      }
    },
    "Hold ⇧ while pasting to switch for a single paste." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte beim Einsetzen ⇧ gedrückt, um nur für dieses Mal umzuschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada ⇧ al pegar para cambiarlo solo esa vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez ⇧ en collant pour inverser l’option le temps d’un collage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto ⇧ mentre incolli per cambiare solo per quella volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペースト時に ⇧ を押したままにすると、その 1 回だけ切り替わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "붙여넣을 때 ⇧를 누르고 있으면 이번 한 번만 반대로 동작합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha ⇧ pressionado ao colar para trocar só naquela vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте ⇧ при вставке, чтобы переключить режим только для этой вставки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "粘贴时按住 ⇧，可仅对本次粘贴切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼上時按住 ⇧，可僅對本次貼上切換。"
          }
        }
      }
    },
    "If Clipbara isn't in the list, add it with the + button." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Clipbara nicht in der Liste ist, füge es mit der Taste + hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
