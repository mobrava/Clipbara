    "This deletes %lld unpinned clips from history. Pinboard items stay available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden %lld nicht angepinnte Clips aus dem Verlauf gelöscht. Objekte in Pinboards bleiben verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán del historial %lld clips no fijados. Los elementos de los tableros siguen disponibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime %lld clips non épinglés de l’historique. Les éléments des tableaux restent disponibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verranno eliminati dalla cronologia %lld clip non fissati. Gli elementi delle bacheche restano disponibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴からピン留めされていない %lld 件のクリップを削除します。ピンボードの項目は残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록에서 핀보드에 없는 클립 %lld개가 삭제됩니다. 핀보드 항목은 그대로 남습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso apaga %lld clipes não fixados do histórico. Os itens dos quadros continuam disponíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Из истории будут удалены незакрепленные клипы: %lld. Элементы на досках останутся доступными."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将从历史记录中删除 %lld 条未固定的剪贴内容。钉板中的项目会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這將從記錄中刪除 %lld 個未釘選的剪貼內容。釘板中的項目會保留。"
          }
        }
      }
    },
    "This removes the pinboard only. The clips stay in clipboard history." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur das Pinboard wird entfernt. Die Clips bleiben im Zwischenablage-Verlauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se elimina el tablero. Los clips se quedan en el historial del portapapeles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul le tableau est supprimé. Les clips restent dans l’historique du presse-papiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
