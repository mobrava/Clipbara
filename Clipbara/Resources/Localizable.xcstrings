    "Off while Reduce Transparency is on in System Settings > Accessibility > Display." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus, solange „Transparenz reduzieren“ unter „Systemeinstellungen > Bedienungshilfen > Anzeige“ aktiviert ist."
          }
        },
        "es" : {
          "stringUnit" : {
