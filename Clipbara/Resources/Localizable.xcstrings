    "Clicking a clip or pressing Return pastes it where you were typing. When off, the clip is only copied." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Klick auf einen Clip oder die Eingabetaste setzt ihn dort ein, wo du gerade geschrieben hast. Wenn aus, wird der Clip nur kopiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al hacer clic en un clip o pulsar Retorno, se pega donde estabas escribiendo. Si está desactivado, el clip solo se copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquer sur un clip ou appuyer sur Retour le colle là où vous écriviez. Lorsque l’option est désactivée, le clip est seulement copié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facendo clic su un clip o premendo A capo, lo incolli dove stavi scrivendo. Se disattivato, il clip viene solo copiato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クリップをクリックするか Return キーを押すと、入力していた場所にペーストします。オフのときはコピーのみ行います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클립을 클릭하거나 Return을 누르면 입력하던 곳에 바로 붙여넣습니다. 끄면 복사만 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clicar em um clipe ou pressionar Return o cola onde você estava digitando. Quando desativado, o clipe é apenas copiado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажатие клипа или клавиши Return вставляет его туда, где Вы печатали. Если выключено, клип только копируется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按剪贴内容或按下 Return 键，即可粘贴到正在输入的位置。关闭时仅复制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下剪貼內容或按下 Return 鍵，即可貼到正在輸入的位置。關閉時僅拷貝。"
          }
        }
      }
    },
