    "No account, no cloud, no telemetry. Your data stays on this Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Account, keine Cloud, keine Telemetrie. Deine Daten bleiben auf diesem Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cuenta, sin nube, sin telemetría. Tus datos se quedan en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de compte, pas de cloud, pas de télémétrie. Vos données restent sur ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun account, nessun cloud, nessuna telemetria. I tuoi dati restano su questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウント不要、クラウドなし、データ収集なし。データはこの Mac に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정도, 클라우드도, 원격 측정도 없습니다. 데이터는 이 Mac에만 남습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem conta, sem nuvem, sem telemetria. Seus dados ficam neste Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без учетной записи, без облака, без телеметрии. Ваши данные остаются на этом Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需账户，没有云端，没有遥测。你的数据只留在这台 Mac 上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無需帳號，沒有雲端，沒有遙測。你的資料只留在這台 Mac 上。"
          }
        }
