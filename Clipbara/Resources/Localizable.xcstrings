            "value" : "Testo, link, immagini, file e colori. Un clic per copiarli di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキスト、リンク、画像、ファイル、カラー。クリック一つでもう一度コピーできます。"
          }
        },
        "ko" : {
