    "%lld clips and %lld pinboards on this device will be uploaded to your iCloud account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Clips und %2$lld Pinboards auf diesem Gerät werden in deinen iCloud-Account geladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se subirán a tu cuenta de iCloud %1$lld clips y %2$lld tableros de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld clips et %2$lld tableaux de cet appareil seront envoyés sur votre compte iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld clip e %2$lld bacheche su questo dispositivo verranno caricati sul tuo account iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイス上の %1$lld 件のクリップと %2$lld 個のピンボードが iCloud アカウントにアップロードされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기의 클립 %1$lld개와 핀보드 %2$lld개가 iCloud 계정에 업로드됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld clipes e %2$lld quadros deste dispositivo serão enviados para sua conta do iCloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клипы (%1$lld) и доски (%2$lld) с этого устройства будут загружены в Вашу учетную запись iCloud."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备上的 %1$lld 个剪贴内容和 %2$lld 个钉板将上传到你的 iCloud 账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置上的 %1$lld 個剪貼內容和 %2$lld 個釘板將上傳到你的 iCloud 帳號。"
          }
        }
      }
    },
    "%lld clips, %lld images (about %@), and %lld pinboards on this device will be uploaded to your iCloud account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Clips, %2$lld Bilder (ca. %3$@) und %4$lld Pinboards auf diesem Gerät werden in deinen iCloud-Account geladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
