    "Off while Reduce Motion is on in System Settings > Accessibility > Display." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado mientras Reducir movimiento esté activado en Ajustes del Sistema > Accesibilidad > Pantalla."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 > 손쉬운 사용 > 디스플레이에서 '동작 줄이기'가 켜져 있는 동안은 꺼집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
