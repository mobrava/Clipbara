    "No account, no cloud, no telemetry. Your data stays on this Mac." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cuenta, sin nube, sin telemetría. Tus datos permanecen en este Mac."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정도, 클라우드도, 원격 측정도 없습니다. 데이터는 이 Mac에만 남습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
