    "No account, no telemetry. Stays on this Mac until you turn on sync." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Account, keine Telemetrie. Bleibt auf diesem Mac, bis du die Synchronisierung aktivierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
