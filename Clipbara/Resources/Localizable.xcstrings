      }
    },
    "Copy something, press %@, and it'll be there.\nClipbara runs quietly in your menu bar." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia algo, presiona %@, y estará ahí.\nClipbara se ejecuta discretamente en tu barra de menú."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무언가를 복사한 다음 %@를 누르면 바로 거기 있습니다.\nClipbara는 메뉴 막대에서 조용히 실행됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复制任意内容，按下 %@，它就在那里。\nClipbara 会在菜单栏中安静运行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複製內容後，按下 %@ 就能在剪貼簿紀錄找到它。\n你也可以從選單列開啟 Clipbara。"
          }
        }
      }
    },
