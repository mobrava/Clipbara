        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desativado enquanto “Reduzir transparência” estiver ativado em Ajustes do Sistema > Acessibilidade > Tela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выключено, пока включен параметр «Понижение прозрачности» в разделе «Системные настройки > Универсальный доступ > Дисплей»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
