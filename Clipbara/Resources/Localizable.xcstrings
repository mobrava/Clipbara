    "Clicking a clip or pressing Return pastes it where you were typing. When off, the clip is only copied." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hacer clic en un clip o presionar Return lo pega donde estabas escribiendo. Cuando está desactivado, el clip solo se copia."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클립을 클릭하거나 Return을 누르면 입력하던 곳에 바로 붙여넣습니다. 끄면 복사만 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按剪贴内容或按下 Return 键，即可粘贴到正在输入的位置。关闭时仅复制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下剪貼內容或按 Return，就能貼到游標所在的位置。關閉時只會複製內容。"
          }
        }
      }
    },
