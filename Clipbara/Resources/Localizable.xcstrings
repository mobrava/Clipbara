            "value" : "Text, Links, Bilder, Dateien & Farben. Ein Klick kopiert es wieder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texto, enlaces, imágenes, archivos y colores. Un clic para volver a copiar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Texte, liens, images, fichiers et couleurs. Un clic pour recopier."
          }
        },
        "it" : {
          "stringUnit" : {
