    "Copy a few things. Each ⌘V then pastes the next one in order." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia varias cosas. Luego, cada ⌘V pega la siguiente en orden."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 항목을 복사하세요. ⌘V를 누를 때마다 다음 항목이 순서대로 붙여넣어집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "复制几项内容，之后每按一次 ⌘V 就会按顺序粘贴下一项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複製幾項內容，之後每按一次 ⌘V 就會按順序貼上下一項。"
          }
        }
      }
    },
    "Copy anything" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia cualquier cosa"
          }
        },
