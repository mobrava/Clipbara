    "A simple clipboard manager for macOS." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "간단한 macOS용 클립보드 매니저입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "简洁的 macOS 剪贴板管理工具。"
          }
        }
      }
    },
    "A single key with no modifiers. It only works while the Clipbara panel is open, so it won't clash with other apps." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보조 키 없이 키 하나만 지정합니다. Clipbara 패널이 열려 있을 때만 동작하므로 다른 앱과 충돌하지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只需一个不带修饰键的按键。仅在 Clipbara 面板打开时生效，因此不会与其他应用冲突。"
          }
        }
      }
    },
    "About" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정보"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关于"
          }
        }
      }
    },
    "Accessibility permission is off, so clips are only copied." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손쉬운 사용 권한이 꺼져 있어 복사만 합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "辅助功能权限未开启，因此仅复制。"
          }
        }
