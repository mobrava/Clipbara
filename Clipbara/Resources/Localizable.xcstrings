    },
    "While the queue is on, everything you copy joins it, and each ⌘V pastes the next item in order." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras la cola está activa, todo lo que copies se une a ella, y cada ⌘V pega el siguiente elemento en orden."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대기열이 켜져 있는 동안 복사한 항목이 모두 대기열에 들어가고, ⌘V를 누를 때마다 다음 항목이 순서대로 붙여넣어집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "队列开启时，复制的内容都会加入队列，每按一次 ⌘V 就会按顺序粘贴下一项。"
          }
        }
      }
    },
    "Works globally, in any app." : {
