    "While the queue is on, everything you copy joins it, and each ⌘V pastes the next item in order." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solange die Warteschlange aktiv ist, landet alles, was du kopierst, darin, und jedes ⌘V setzt das nächste Objekt der Reihe nach ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras la cola está activada, todo lo que copias se añade a ella y cada ⌘V pega el siguiente elemento en orden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tant que la file est active, tout ce que vous copiez la rejoint, et chaque ⌘V colle l’élément suivant, dans l’ordre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando la coda è attiva, tutto ciò che copi vi viene aggiunto e ogni ⌘V incolla l’elemento successivo, in ordine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キューがオンのあいだ、コピーしたものはすべてキューに加わり、⌘V を押すたびに次の項目が順番にペーストされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대기열이 켜져 있는 동안 복사한 항목이 모두 대기열에 들어가고, ⌘V를 누를 때마다 다음 항목이 순서대로 붙여넣어집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto a fila está ativada, tudo o que você copia entra nela, e cada ⌘V cola o próximo item, em ordem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока очередь включена, все, что Вы копируете, попадает в нее, а каждое ⌘V вставляет следующий элемент по порядку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "队列开启时，复制的内容都会加入队列，每按一次 ⌘V 就会按顺序粘贴下一项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "佇列開啟時，拷貝的內容都會加入佇列，每按一次 ⌘V 就會依序貼上下一項。"
          }
        }
      }
    },
