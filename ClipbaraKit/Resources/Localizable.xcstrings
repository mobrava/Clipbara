    "Copy something, then tap the paste button to save it here." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia algo y luego toca el botón de pegar para guardarlo aquí."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무언가를 복사한 뒤 붙여넣기 버튼을 누르면 여기에 저장됩니다."
          }
        },
        "zh-Hans" : {
