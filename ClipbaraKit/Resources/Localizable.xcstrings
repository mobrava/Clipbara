    "Clipbara kept saving and syncing your clips. Settings stay available." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clipbara siguió guardando y sincronizando tus clips. Los Ajustes siguen disponibles."
